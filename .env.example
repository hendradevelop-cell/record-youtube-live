# Salin file ini menjadi .env.local lalu isi nilainya.
# Worker membaca .env.local saat start — restart worker setelah mengubahnya.

# ==== S3-compatible (AWS, Cloudflare R2, MinIO, Backblaze B2) ====
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Opsional:
# AWS_SESSION_TOKEN=
# S3_ENDPOINT=https://xxxx.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=1
# S3_PUBLIC_BASE_URL=https://cdn.contoh.com

# ==== Google Drive (service account) ====
# Path ke file JSON service account; folder harus sudah di-share ke email service account.
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\ke\service-account.json

# ==== Override biner (opsional) ====
# YTDLP_PATH=bin/yt-dlp.exe
# FFMPEG_PATH=C:\tools\ffmpeg.exe
# FFPROBE_PATH=C:\tools\ffprobe.exe
