{
  "name": "yt-live-recorder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,worker -c blue,magenta \"next dev -p 3100 -H 0.0.0.0\" \"tsx watch worker/index.ts\"",
    "build": "next build",
    "start": "concurrently -n web,worker -c blue,magenta \"next start -p 3100 -H 0.0.0.0\" \"tsx worker/index.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1165.0",
    "@aws-sdk/lib-storage": "^3.1165.0",
    "@googleapis/drive": "^27.0.0",
    "google-auth-library": "^11.3.4",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
